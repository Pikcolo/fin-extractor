__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.pytest_cache/

# ข้อมูลจริงอาจมีข้อมูลส่วนบุคคล/ภาษี — ไม่ commit อะไรใต้ data/ ทั้งหมด ยกเว้น .gitkeep ที่รักษาโครงโฟลเดอร์
data/**
!data/**/
!data/**/.gitkeep

# โมเดลที่ library ดาวน์โหลดเอง (Paddle) เก็บในโปรเจกต์แต่ไม่ commit
models/**
!models/**/
!models/.gitkeep

# notebook ที่สร้างจาก scripts/make_preprocess_notebooks.py: รันแล้วมีภาพสแกนเอกสารภาษีจริงฝังใน output — ไม่ commit (สร้างใหม่ได้ด้วยสคริปต์)
notebooks/preprocess_lab/**/*.ipynb
notebooks/preprocess_lab/**/.ipynb_checkpoints/
